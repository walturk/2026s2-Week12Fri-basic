# Step 1: load the dishes so the order can use real dish IDs
# @name dishes
GET http://localhost:5001/api/dish

###
# Step 2: place a random order (random quantities, random customer) using the first two dishes
# Run Step 1 first. Needs at least 2 dishes in Firestore.
POST http://localhost:5001/api/order/create
Content-Type: application/json

{
  "customerName": "WALID",
  "notes": "Random order {{$guid}}",
  "items": [
    { "dishId": "0R8F3VvJbjXvCWmmrMRP", "quantity": {{$randomInt 1 5}} },
    { "dishId": "161jnooFQRat5sBuIjii", "quantity": {{$randomInt 1 5}} }
  ]
}



